# Copie para plataforma/.env.local e ajuste. Nunca coloque este arquivo preenchido no git.

# Banco local (docker-compose.yml). Em produção, a URL do Postgres hospedado.
DATABASE_URL=postgres://contabilizadev:desenvolvimento@localhost:5433/contabilizadev
# Banco dos testes de integração (opcional). Sem ela, os testes usam o mesmo servidor com o banco "<nome>_teste",
# criado sozinho. Nunca aponte para o banco de desenvolvimento: o teste recusa banco cujo nome não termina em _teste.
# DATABASE_URL_TESTE=postgres://contabilizadev:desenvolvimento@localhost:5433/contabilizadev_teste

# Segredo que assina o cookie de sessão (mínimo 32 caracteres; sem ele o servidor não sobe).
# Gere com: openssl rand -base64 48
SESSAO_SEGREDO=

# Client ID do Google (tipo "Aplicativo da Web"), criado no Google Cloud Console (passo a passo no README).
# Sem ele, a tela de entrada avisa que o login com Google não está configurado.
GOOGLE_CLIENT_ID=

# Quem é administrador da plataforma, separado por vírgula. Vazio = ninguém.
ADMIN_EMAILS=

# Localmente não há login: com AUTH_DISABLED=true (o padrão do desenvolvimento local), abrir http://localhost:3001
# cai direto no painel, já com a sessão da conta DEV_USER_EMAIL (criada sozinha no servidor, sem tela nem botão).
# Em produção (NODE_ENV=production) a variável é ignorada e o login com Google é obrigatório. Qualquer valor
# diferente de "true" (ou a falta da variável) liga o login, também localmente.
AUTH_DISABLED=true
# DEV_USER_EMAIL=dev@contabilizadev.local

# Chave que cifra, no banco, o termo de autorização assinado e o token de cada empresa (AES-256-GCM). Obrigatória: sem
# ela (ou inválida) o servidor não sobe. 32 bytes em base64 ou em hexadecimal. Gere com: openssl rand -base64 32
# Trocar a chave invalida os termos guardados (os clientes assinam de novo). Nunca a coloque no git.
TOKEN_CHAVE=

# Chave que cifra, no banco, o certificado da plataforma (o e-CNPJ A1) e as chaves do contrato, informados por um ADMIN na
# tela interna /admin/plataforma (Área do administrador › Certificado da plataforma), com AES-256-GCM. Obrigatória e DIFERENTE da TOKEN_CHAVE: sem ela, inválida ou igual, o
# servidor não sobe. 32 bytes em base64 ou em hexadecimal. Gere com: openssl rand -base64 32
# Trocar a chave deixa o guardado ilegível: a tela pede para enviar o certificado e as chaves de novo. Nunca a coloque no git.
PLATAFORMA_CHAVE=

# CNPJ da plataforma: o contratante do Serpro e o destinatário do termo de autorização que cada cliente assina em
# "Ligar o automático". Com ou sem pontuação. Sem ele, a assinatura fica indisponível (a tela diz isso ao cliente).
PLATAFORMA_CNPJ=
# Razão social do PLATAFORMA_CNPJ, como a Receita mostra (vai no termo como o nome do destinatário). Sem ela, vale a
# razão social da empresa com esse CNPJ, se estiver cadastrada aqui por uma conta de ADMIN_EMAILS (só um ADMIN cadastra
# o PLATAFORMA_CNPJ); sem nenhuma das duas, a assinatura fica indisponível.
PLATAFORMA_RAZAO_SOCIAL=

# Contrato da plataforma com o Serpro (Integra Contador): o certificado da plataforma (e-CNPJ A1 do PLATAFORMA_CNPJ, usado
# no TLS mútuo com o Serpro e para transmitir os lotes do eSocial) e as chaves (Área do Cliente do Serpro).
# O jeito principal é a tela interna /admin/plataforma (Área do administrador › Certificado da plataforma, só ADMIN): envie o .pfx e a senha e informe as chaves; ficam
# cifrados no banco com a PLATAFORMA_CHAVE (o certificado já aberto, a senha não é guardada) e valem sem depender de
# arquivo nenhum. As variáveis abaixo são a ALTERNATIVA, usadas só para o que não estiver guardado no banco.
# Sem certificado ou sem chaves (nem no banco nem aqui), a assinatura do termo fica indisponível (a tela diz isso sem
# citar o Serpro), nada é chamado e o eSocial fica no modo guiado (portal do eSocial com os valores prontos).
# Nunca coloque o .pfx dentro do projeto nem no git. CERT_PFX_PATH com caminho absoluto: o npm run docker:subir usa o
# mesmo valor para montar o arquivo (só leitura) no contêiner, em /run/secrets/plataforma.pfx.
SERPRO_CONSUMER_KEY=
SERPRO_CONSUMER_SECRET=
CERT_PFX_PATH=
CERT_PFX_SENHA=
# Limite de chamadas cobradas por período de cobrança (dia 21 ao dia 20). Opcional; padrão 40.
# SERPRO_LIMITE_POR_PERIODO=40
